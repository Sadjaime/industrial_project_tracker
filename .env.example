# Copy this file to .env and fill in local values. Never commit .env.
# URL-encode special characters in the password (for example, @ becomes %40).
# PostgreSQL is the only supported application database.
DATABASE_URL=postgresql+psycopg://ipt_user:replace_me@127.0.0.1:5432/industrial_project_tracker

# SQLite is used only by the isolated automated test suite, which sets its own
# temporary DATABASE_URL before importing the application.
